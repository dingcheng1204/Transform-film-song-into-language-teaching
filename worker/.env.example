# Worker only — never commit the real .env
SUPABASE_URL=https://yzqirjnhldwqjjakxeko.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# CPU defaults (no NVIDIA GPU)
WHISPER_MODEL=medium
DEVICE=cpu
COMPUTE_TYPE=int8
BATCH_SIZE=4
POLL_SECONDS=5
