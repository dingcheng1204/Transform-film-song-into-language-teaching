      ],
      "lesson": {
        "grammarNotes": [
          "걸어갈까：걸어가다（走過去）＋ -ㄹ까，用來提議或自問「要不要……呢」。",
          "아래서：아래（下面）＋ -서（-에서 的縮寫），表示「在……」。"
        ],
        "pronunciationNotes": [
          "같이 不念 갇이，ㅌ 遇到 이 會顎化成 ㅊ，念 가치 gachi。",
          "별빛 的 빛 前面接 ㄹ，要念成緊音 삗，喉嚨用力、不送氣。"
        ],
        "connectedSpeech": [
          "걸어갈까 → 거러갈까：收尾音 ㄹ 移到下一個字的 ㅇ 位置（連音）。",
          "갈까 的 ㄲ 是緊音，像注音 ㄍ 但更用力、完全不送氣。"
        ],
        "singingTips": [
          "갈까 在句尾拉長，拉的是 까 的母音 a。",
          "兩句之間在 갈까 後面換氣。"
        ],
        "ttsRate": 0.75,
        "patterns": [
          {
            "pattern": "같이 〔動詞〕-ㄹ까?",
            "explanation": "提議「要不要一起……？」，對朋友說的半語。",
            "examples": [
              {
                "text": "같이 먹을까?",
                "translation": "要一起吃嗎？",
                "swap": "걸어가다 → 먹다",
                "reading": "가치 머글까?",
                "romanization": "gachi meogeulkka"
              },
              {
                "text": "같이 갈까?",
                "translation": "要一起去嗎？",
                "swap": "걸어가다 → 가다",
                "reading": "가치 갈까?",
                "romanization": "gachi galkka"
              },
              {
                "text": "같이 볼까?",
                "translation": "要一起看嗎？",
                "swap": "걸어가다 → 보다",
                "reading": "가치 볼까?",
                "romanization": "gachi bolkka"
              }
            ]
          }
        ]
      }
